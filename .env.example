# ==============================================================================
# LIZENZMANAGER - AD / LDAP KONFIGURATIONSDATEI (.env)
# ==============================================================================
# Um diese Datei zu nutzen, kopieren Sie sie nach '.env' und tragen Sie Ihre
# Firmendaten ein.
# ==============================================================================

# Geheimer Session-Schlüssel
SECRET_KEY=a-secure-random-secret-key-12345

# Authentifizierung ein-/ausschalten (True/False)
AUTH_ENABLED=True

# Hostname oder IP-Adresse Ihres Domain Controllers (z. B. dc01.ihrefirma.local oder 192.168.1.10)
LDAP_HOST=dc01.firma.local

# LDAP-Port (389 für Standard LDAP, 636 für LDAPS)
LDAP_PORT=389

# SSL verwenden (True bei Port 636)
LDAP_USE_SSL=False

# Domänenname (z. B. FIRMA oder firma.local)
LDAP_DOMAIN=FIRMA.LOCAL

# Suchbasis (Base DN) für Benutzerabfragen
LDAP_SEARCH_BASE=DC=firma,DC=local

# Optionale Beschränkung: Nur Mitglieder dieser Gruppe dürfen sich einloggen (leer = alle)
LDAP_REQUIRED_GROUP=

# AD-Gruppe für Administratoren (volle Rechte)
LDAP_ADMIN_GROUP=Lizenz-Admins

# Lokaler Fallback-Login (admin / admin), falls DC nicht erreichbar ist (True / False)
ALLOW_DEMO_FALLBACK=True

# ==============================================================================
# KI-SERVER (vLLM / OPENAI-KOMPATIBEL)
# ==============================================================================
# Automatische Rechnungsextraktion & Lizenzentwürfe aktivieren (True / False)
AI_ENABLED=True

# URL des vLLM / OpenAI API Endpunkts (z. B. https://api.openai.com/v1 oder eigener vLLM Host)
AI_API_BASE=https://api.openai.com/v1

# Modellname (z. B. openai/gpt-oss-120b)
AI_MODEL=openai/gpt-oss-120b

# Optionaler API-Key (falls Authentifizierung erforderlich ist)
AI_API_KEY=

# Timeout für KI-Anfragen in Sekunden
AI_TIMEOUT=60

