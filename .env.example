# ==============================================================================
# LIZENZMANAGER - AD / LDAP KONFIGURATIONSDATEI (.env)
# ==============================================================================
# Um diese Datei zu nutzen, kopieren Sie sie nach '.env' und tragen Sie Ihre
# Firmendaten ein.
# ==============================================================================

# Geheimer Session-Schlüssel
SECRET_KEY=a-secure-random-secret-key-12345

# Authentifizierung ein-/ausschalten (True/False)
AUTH_ENABLED=True

# Hostname oder IP-Adresse Ihres Domain Controllers (z. B. dc01.ihrefirma.local oder 192.168.1.10)
LDAP_HOST=dc01.firma.local

# LDAP-Port (389 für Standard LDAP, 636 für LDAPS)
LDAP_PORT=389

# SSL verwenden (True bei Port 636)
LDAP_USE_SSL=False

# Domänenname (z. B. FIRMA oder firma.local)
LDAP_DOMAIN=FIRMA.LOCAL

# Suchbasis (Base DN) für Benutzerabfragen
LDAP_SEARCH_BASE=DC=firma,DC=local

# Optionale Beschränkung: Nur Mitglieder dieser Gruppe dürfen sich einloggen (leer = alle)
LDAP_REQUIRED_GROUP=

# AD-Gruppe für Administratoren (volle Rechte: Lizenzen, Benutzer, Logs, Backup)
LDAP_ADMIN_GROUP=Lizenz-Admins

# AD-Gruppe für Bearbeiter (Lizenzen hinzufügen, bearbeiten, verlängern & löschen)
LDAP_EDITOR_GROUP=Lizenz-Bearbeiter

# ==============================================================================
# LOKALER ADMINISTRATOR (ERSTEINRICHTUNG)
# ==============================================================================
# Standardmäßig richtet der Benutzer beim ersten Start über die Web-Oberfläche (/setup)
# interaktiv das Administrator-Konto und Kennwort ein.
# Für automatisierte / unüberwachte Deployments (z. B. Docker) kann hier optional
# ein Initial-Kennwort vorgegeben werden:
# INITIAL_ADMIN_USER=admin
# INITIAL_ADMIN_PASSWORD=

# Lokaler Notfall-Login bei Ausfall des Domain Controllers (True / False, Standard: False)
ALLOW_DEMO_FALLBACK=False
# Benutzername und sicheres Kennwort für Notfall-Login (falls ALLOW_DEMO_FALLBACK=True)
LOCAL_ADMIN_USER=admin
LOCAL_ADMIN_PASSWORD=

# ==============================================================================
# KI-SERVER (vLLM / OPENAI-KOMPATIBEL)
# ==============================================================================
# Automatische Rechnungsextraktion & Lizenzentwürfe aktivieren (True / False)
AI_ENABLED=True

# URL des vLLM / OpenAI API Endpunkts (z. B. http://localhost:8000/v1 oder https://api.openai.com/v1)
AI_API_BASE=http://localhost:8000/v1

# Modellname (z. B. openai/gpt-oss-120b)
AI_MODEL=openai/gpt-oss-120b

# Optionaler API-Key (falls Authentifizierung erforderlich ist)
AI_API_KEY=

# Timeout für KI-Anfragen in Sekunden
AI_TIMEOUT=60

# ==============================================================================
# SYSTEM & UPDATE-PRÜFUNG
# ==============================================================================
# Automatische Prüfung auf neue GitHub-Releases (True / False, Standard: True)
CHECK_FOR_UPDATES=True

